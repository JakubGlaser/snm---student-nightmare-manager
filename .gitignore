# Godot 4+ specific ignores
.godot/
/android/

# Local-only sprite backups created during UI swaps
sprites/_backup_*/
sprites/_original_backup/

# Krita working files / autosaves
*.kra
*.kra~
*-autosave.kra

# Exported build artifacts (too large for GitHub; rebuild via Project > Export)
*.exe
*.pck
